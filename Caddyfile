# Public API edge for the Vercel frontend.
# Certificates are issued automatically by Caddy (Let's Encrypt) as long as
# ports 80 and 443 on the VPS reach this process and DNS for the site name
# points at the VPS.
#
# CORS is applied here, once. Upstream FastAPI also sets Access-Control-*
# from CORS_ORIGINS; those copies are stripped below so the browser sees a
# single Allow-Origin. With credentials, that origin must be explicit
# (never "*"). Set FRONTEND_ORIGIN to the Vercel production origin,
# for example https://ocoach.app, with no trailing slash.
{
	email {$ACME_EMAIL:admin@ocoach.app}
	servers {
		timeouts {
			read_body 15m
			write 15m
			idle 5m
		}
	}
}

{$API_DOMAIN:api.ocoach.app} {
	@compressible {
		not path /api/chat
	}
	encode @compressible gzip zstd

	@from_frontend header Origin "{$FRONTEND_ORIGIN:https://ocoach.app}"

	header @from_frontend {
		defer
		Access-Control-Allow-Origin "{$FRONTEND_ORIGIN:https://ocoach.app}"
		Access-Control-Allow-Credentials "true"
		Access-Control-Allow-Headers "Authorization, Content-Type, X-API-Key"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Max-Age "600"
		Vary "Origin"
	}

	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# POST /api/chat is text/event-stream. flush_interval -1 sends each chunk
	# immediately. HTTP/1.1 to the upstream avoids HTTP/2 framing that can
	# hold SSE frames. X-Accel-Buffering is for any nginx in front of Caddy;
	# Caddy itself does not buffer once flush_interval is -1.
	reverse_proxy backend:8000 {
		header_up X-Accel-Buffering "no"
		header_up X-Real-IP {remote_host}
		flush_interval -1
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Credentials
		header_down -Access-Control-Allow-Headers
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Max-Age
		transport http {
			versions 1.1
			dial_timeout 5s
			read_timeout 900s
			write_timeout 900s
		}
	}
}
