SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret Key (`sb_secret_...`) for backend/server-side Supabase access.
# Phase 4: chat history. Phase 5: profile RPC + reads.
# Bypasses RLS — never expose to the frontend.
SUPABASE_SECRET_KEY=

# Optional: dedicated Fernet key for encrypting BYOK API keys at rest.
# If unset, SUPABASE_SECRET_KEY is used as the encryption seed.
# PROFILE_ENCRYPTION_KEY=

# Server-side OpenAI key. RAG embeddings are NEVER BYOK: the agent's
# `search_cp_knowledge` tool (services/tools/rag_tool.py) always uses this
# key, and `python -m scripts.ingest` falls back to it when `--api-key`
# isn't passed. The only endpoint that still accepts a caller-supplied
# OpenAI key is the debug-only `POST /api/rag/search`, via its own
# `X-API-Key` header (see routes/rag.py) -- unrelated to this setting, and
# unrelated to the chat endpoint, which never accepts BYOK keys from the
# client at all (the Anthropic key is resolved server-side per request
# from the caller's Fernet-encrypted `profiles` row; see core/crypto.py).
# Never commit a real key value to this example file.
OPENAI_API_KEY=

# Phase 6: direct Postgres DSN for the LangGraph agent-memory checkpointer.
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> URI. Prefer the *Session pooler* (port 5432) or a direct connection —
# NOT the *Transaction pooler* (port 6543), which is incompatible with the
# checkpointer's use of prepared statements. Leave unset to run without
# persistent cross-request agent memory (each chat turn still works, but
# `thread_id` history isn't recalled across process restarts).
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Phase 7: local Piston sandbox for agent/tools.py's `compile_and_test_cpp`.
# Run the privileged `piston_api` container (`piston/docker-compose.yml`) and
# install the `gcc` package first. Leave unset to disable the tool (it returns
# a clear error to the agent instead of the app failing to start).
# Stdout cap is a *container* env var (`PISTON_OUTPUT_MAX_SIZE=65536` in that
# compose file), not this backend setting — recreate the container to apply it.
PISTON_API_URL=http://localhost:2000/api/v2/execute

# Production only (docker-compose.prod.yml). Leave unset for local embedded
# Qdrant under ./qdrant_data. Setting QDRANT_HOST switches the client to the
# Qdrant REST API, which is required once uvicorn runs more than one worker.
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_API_KEY=
