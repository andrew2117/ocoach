# Copy to .env.production on the VPS and fill in real values.
# Never commit .env.production. docker compose interpolates this file when
# you pass `--env-file .env.production`. The backend container also loads it
# via env_file. Compose overrides QDRANT_HOST, QDRANT_PORT, and
# PISTON_API_URL with the in-network addresses, so those values below are
# the ones the process actually uses.

# --- Edge (Caddy) ---
API_DOMAIN=api.ocoach.app
# Let's Encrypt account. Use a mailbox you read.
ACME_EMAIL=you@example.com
# Vercel production origin. No trailing slash. Must match CORS_ORIGINS.
FRONTEND_ORIGIN=https://ocoach.app

# --- Image (CI sets the SHA tag at rollout time) ---
# Lowercase GHCR path: ghcr.io/<owner>/<repo>/backend
BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend
BACKEND_IMAGE_TAG=latest

# --- Backend secrets ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server secret: legacy service-role JWT or sb_secret_...
# The app also accepts the canonical name SUPABASE_SECRET_KEY. Set only one.
# If both are present, SUPABASE_SECRET_KEY wins.
SUPABASE_SERVICE_ROLE_KEY=

# Seed for BYOK encryption. core/crypto.py hashes this string; any
# high-entropy value works. Generate: openssl rand -base64 32
# Canonical name is PROFILE_ENCRYPTION_KEY. Set only one; that name wins
# if both are present.
FERNET_ENCRYPTION_KEY=

# Server-side embeddings only. User chat keys stay in Supabase, encrypted.
OPENAI_API_KEY=

# JSON list. pydantic-settings parses this into Settings.cors_origins.
# Include every browser origin that calls the API (apex, www, Vercel URL).
CORS_ORIGINS=["https://ocoach.app"]

# LangGraph checkpointer. Session pooler or direct connection, port 5432.
# Do not use the transaction pooler (port 6543).
# Four uvicorn workers each open a pool; keep the max small.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
CHECKPOINTER_POOL_MIN_SIZE=1
CHECKPOINTER_POOL_MAX_SIZE=2

# Overridden inside docker-compose.prod.yml. Change them there if these
# services are not the compose service names.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Optional. Leave empty while Qdrant has no published port.
# QDRANT_API_KEY=

# Full execute endpoint, not the server root. PISTON_URL is an alias of
# PISTON_API_URL. Compose sets PISTON_API_URL on the container, and that
# name wins when both are present.
PISTON_URL=http://piston:2000/api/v2/execute

# --- Vercel project (not read by the VPS) ---
# NEXT_PUBLIC_API_URL=https://api.ocoach.app
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
